USE huerta;

CREATE TABLE IF NOT EXISTS humedad (
    id INT AUTO_INCREMENT PRIMARY KEY,
    valor DECIMAL(5,2) NOT NULL
);

CREATE TABLE IF NOT EXISTS suelo (
    id INT AUTO_INCREMENT PRIMARY KEY,
    estado VARCHAR(100) NOT NULL
);

CREATE TABLE IF NOT EXISTS temperatura (
    id INT AUTO_INCREMENT PRIMARY KEY,
    valor DECIMAL(5,2) NOT NULL
);
